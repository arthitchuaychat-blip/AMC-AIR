{
  "crons": [
    { "path": "/api/mentor-cron", "schedule": "0 2 * * *" },
    { "path": "/api/hr-cron", "schedule": "15 2 * * *" }
  ],
  "rewrites": [{ "source": "/((?!api/|mentor).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/mentor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
