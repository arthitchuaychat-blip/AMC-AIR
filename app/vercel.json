{
  "functions": {
    "api/line-webhook.js": { "maxDuration": 60 },
    "api/fb-webhook.js": { "maxDuration": 60 },
    "api/fb-backfill.js": { "maxDuration": 60 },
    "api/boq-ai.js": { "maxDuration": 90 }
  },
  "crons": [
    { "path": "/api/hr-cron", "schedule": "15 2 * * *" },
    { "path": "/api/daily-cron", "schedule": "0 1 * * *" }
  ],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
