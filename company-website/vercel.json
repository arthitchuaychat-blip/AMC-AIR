{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/air-conditioners", "destination": "/api/landing?slug=air-conditioners" },
    { "source": "/air-conditioners/wall-mounted", "destination": "/api/landing?slug=air-conditioners/wall-mounted" },
    { "source": "/air-conditioners/cassette", "destination": "/api/landing?slug=air-conditioners/cassette" },
    { "source": "/services/installation", "destination": "/api/landing?slug=services/installation" },
    { "source": "/services/cleaning", "destination": "/api/landing?slug=services/cleaning" },
    { "source": "/services/repair", "destination": "/api/landing?slug=services/repair" },
    { "source": "/services/relocation", "destination": "/api/landing?slug=services/relocation" },
    { "source": "/products", "destination": "/" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/a/:id", "destination": "/api/article?id=:id" },
    { "source": "/p/:code", "destination": "/api/product?code=:code" },
    { "source": "/p/:c1/:c2", "destination": "/api/product?code=:c1/:c2" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
